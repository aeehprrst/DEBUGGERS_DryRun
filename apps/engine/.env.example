# apps/engine/.env.example — TRD v2 §11. Copy to `.env` and fill in.
# No real keys in this file, ever. Check `git log -p` before the repo goes public.
#
# READ THIS FIRST: most of the variables below are declared here and read by NO
# CODE. Setting them does nothing. Exactly three have any effect today:
#
#   DATABASE_URL            — read by Prisma
#   DRYRUN_REPLAY           — read by apps/engine/src/replay.ts
#   DRYRUN_REPLAY_PACE_MS   — read by apps/engine/src/server.ts (presentation only)
#
# PORT, ALLOW_PRIVATE_TARGETS, MODEL_*, DECISION_CACHE and CRAWL_MAX_* are
# aspirational: the port is hardcoded 4000, and the others name subsystems that
# are unbuilt or cut. They are left here because the TRD specifies them, not
# because they work — do not assume setting one changes anything.

# SQLite file. Prisma resolves a relative sqlite URL against the SCHEMA's
# directory (apps/engine/prisma/), so `../data/` lands in apps/engine/data/.
DATABASE_URL="file:../data/dryrun.db"

# Fastify listen port for the engine.
PORT=

# CLAUDE.md §8 / TRD §9 S2 — SSRF guard escape hatch. Set to 1 locally so the
# crawler may reach Meridian on localhost. Never a shipped default.
ALLOW_PRIVATE_TARGETS=

# TRD §5.3 — single OpenAI-compatible provider. Absent ⇒ heuristic-only path,
# which must work on its own (venue network is untrusted).
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# TRD §5.3 — memoise decisions per (archetype, stateFingerprint). 1 to enable.
DECISION_CACHE=

# CLAUDE.md L5 / TRD §5.8 — set to a fixture id under apps/engine/fixtures/ to
# replay a cached crawl instead of driving a real browser. Empty = live crawl.
DRYRUN_REPLAY=

# READ BY CODE (server.ts). Presentation only: milliseconds to wait after each
# SSE emission while replaying, so the Live view is watchable on a projector
# rather than finishing in under a second. Empty or 0 = off, current behaviour.
# It changes NOTHING about the data — same states, edges, order, counts,
# findings and scores at any pace; only playback speed. Deliberately not visible
# to the evaluation harness, so `pnpm demo` stays at its measured wall clock.
DRYRUN_REPLAY_PACE_MS=

# TRD §5.2.2 — crawl budget caps.
CRAWL_MAX_STATES=
CRAWL_MAX_DEPTH=
