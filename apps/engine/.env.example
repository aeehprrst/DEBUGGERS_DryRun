# apps/engine/.env.example — TRD v2 §11. Copy to `.env` and fill in.
# No real keys in this file, ever. Check `git log -p` before the repo goes public.
#
# READ THIS FIRST: most of the variables below are declared here and read by NO
# CODE. Setting them does nothing. Exactly three have any effect today:
#
#   DATABASE_URL            — read by Prisma
#   DRYRUN_REPLAY           — read by apps/engine/src/replay.ts
#   DRYRUN_REPLAY_PACE_MS   — read by apps/engine/src/server.ts (presentation only)
#   ALLOW_PRIVATE_TARGETS   — read by apps/engine/src/safety/ssrf.ts (CR-10)
#
# PORT, MODEL_*, DECISION_CACHE and CRAWL_MAX_* are aspirational: the port is
# hardcoded 4000, and the others name subsystems that are unbuilt or cut. They
# are left here because the TRD specifies them, not because they work — do not
# assume setting one changes anything.

# SQLite file. Prisma resolves a relative sqlite URL against the SCHEMA's
# directory (apps/engine/prisma/), so `../data/` lands in apps/engine/data/.
DATABASE_URL="file:../data/dryrun.db"

# Fastify listen port for the engine.
PORT=

# READ BY CODE (src/safety/ssrf.ts). CLAUDE.md §8 / TRD §9 S2 — the SSRF
# guard's escape hatch, and the only way past it.
#
# POST /runs resolves the target hostname through DNS and returns 400 if any
# address it answers with is loopback, private, link-local, unique-local,
# CGNAT, multicast or reserved. It resolves the NAME rather than string-matching
# the URL, so a public hostname whose A record points at 127.0.0.1 is rejected
# too.
#
# YOU NEED THIS LOCALLY. Meridian runs on http://localhost:5173, which is
# loopback, so a LIVE crawl of it — `pnpm demo:live`, or a run launched from the
# interface with DRYRUN_REPLAY unset — is refused unless this is set:
#
#     ALLOW_PRIVATE_TARGETS=1
#
# A REPLAYED run does not need it. Replay serves the crawl from a committed
# fixture and issues no request to the target at all, so there is no host to
# guard and the check is skipped: `pnpm demo` and the stage demo both work with
# this unset. That is deliberate — the demo must not be refusable by a guard
# protecting against traffic that never happens.
#
# NEVER SHIP THIS SET. In a deployed environment a 1 here turns the engine into
# an open proxy into whatever private network it can reach: cloud metadata at
# 169.254.169.254, internal admin panels, databases on 10.x. It is a local
# development switch and nothing else. Empty or absent = guard on.
ALLOW_PRIVATE_TARGETS=

# TRD §5.3 — single OpenAI-compatible provider. Absent ⇒ heuristic-only path,
# which must work on its own (venue network is untrusted).
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# TRD §5.3 — memoise decisions per (archetype, stateFingerprint). 1 to enable.
DECISION_CACHE=

# CLAUDE.md L5 / TRD §5.8 — set to a fixture id under apps/engine/fixtures/ to
# replay a cached crawl instead of driving a real browser. Empty = live crawl.
DRYRUN_REPLAY=

# READ BY CODE (server.ts). Presentation only: milliseconds to wait after each
# SSE emission while replaying, so the Live view is watchable on a projector
# rather than finishing in under a second. Empty or 0 = off, current behaviour.
# It changes NOTHING about the data — same states, edges, order, counts,
# findings and scores at any pace; only playback speed. Deliberately not visible
# to the evaluation harness, so `pnpm demo` stays at its measured wall clock.
DRYRUN_REPLAY_PACE_MS=

# TRD §5.2.2 — crawl budget caps.
CRAWL_MAX_STATES=
CRAWL_MAX_DEPTH=
